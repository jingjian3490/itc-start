{#
Pattern: carousel_item (Child)
Fields: field_image, field_title (Name), field_job_title, field_description (Quote), field_mind
#}
<div class="paragraph-carousel-item w-full">
  <div class="flex flex-col md:flex-row gap-[30px] md:gap-[40px] items-stretch max-w-[1100px] mx-auto">

    {# === Left: Image === #}
    {% if content.field_image|render %}
      <div class="flex-shrink-0 w-full md:w-[300px] relative">
        <div class="rounded-[20px] overflow-hidden h-full w-full absolute inset-0 md:relative">
          <div class="w-full h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover">
            {{ content.field_image }}
          </div>
        </div>
        <div class="md:hidden h-[300px]"></div>
      </div>
    {% endif %}

    {# === Right: Content === #}
    <div class="flex-grow text-center md:text-left flex flex-col">

      {# 1. Name #}
      {% if content.field_title|render %}
        <h3 class="font-['Ubuntu',sans-serif] font-medium text-[30px] leading-[40px] text-itc-black mb-[5px]">
          {{ content.field_title }}
        </h3>
      {% endif %}

      {# 2. Job Title #}
      {% if content.field_job_title|render %}
        {#
        SPACING FIX: (30px -> 20px)
        #}
        <div class="font-['Lato',sans-serif] text-[20px] leading-[30px] text-itc-black mb-[20px]">
          {{ content.field_job_title }}
        </div>
      {% endif %}

      {# 3. Quote #}
      {% if content.field_description|render %}
        <div class="font-serif italic text-[16px] leading-[30px] text-itc-black mb-[20px]">
          {{ content.field_description }}
        </div>
      {% endif %}

      {# 4. Mind #}
      {% if content.field_mind|render %}
        <div class="font-['Ubuntu',sans-serif] font-bold text-[40px] md:text-[50px] leading-[1.1] text-gray-200 uppercase tracking-wider select-none">
          {{ content.field_mind }}
        </div>
      {% endif %}

    </div>

  </div>
</div>
