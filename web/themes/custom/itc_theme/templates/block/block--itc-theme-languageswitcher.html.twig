{# Block: Language Switcher #}
<div class="block-language-switcher relative ml-4 mr-6 hidden md:block">

  <button class="js-lang-toggle flex items-center gap-2 font-['Ubuntu',sans-serif] font-bold text-[14px] text-itc-black hover:text-itc-red transition-colors cursor-pointer focus:outline-none">
    <span class="js-current-lang-text">EN</span>
    {# Chevron Down Icon #}
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 transition-transform duration-200 js-lang-arrow">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </button>


  <div class="js-lang-dropdown absolute right-0 top-[150%] w-[100px] bg-white shadow-lg rounded-lg py-2 opacity-0 invisible transform -translate-y-2 transition-all duration-200 z-50">

    <div class="lang-list-wrapper [&_ul]:list-none [&_ul]:p-0 [&_ul]:m-0 [&_li]:m-0 [&_a]:block [&_a]:px-4 [&_a]:py-2 [&_a]:text-sm [&_a]:text-itc-dark-gray [&_a]:hover:bg-gray-50 [&_a]:hover:text-itc-red">
      {{ content }}
    </div>
  </div>
</div>
